// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  passwordHash      String
  baseCurrency      String           @default("INR")
  monthlyBudget     Decimal?         @db.Decimal(10, 2)
  emailReminders    Boolean          @default(true)
  budgetAlertSentAt DateTime?
  createdAt         DateTime         @default(now())
  lastLogoutAt      DateTime?
  subscriptions     Subscription[]
  paymentHistory    PaymentHistory[]
  priceHistory      PriceHistory[]
  categoryBudgets   CategoryBudget[]
  sessions          SessionLog[]

  @@index([email])
}

model Subscription {
  id             String           @id @default(cuid())
  userId         String
  name           String
  cost           Decimal          @db.Decimal(10, 2)
  currency       String           @default("INR")
  category       String
  billingCycle   String // "monthly" | "yearly"
  nextPayment    DateTime
  status         String           @default("active") // "active" | "cancelled" | "paused"
  trialEndsOn    DateTime?
  cancelledAt    DateTime?
  worthItRating  Int?
  notes          String?
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentHistory PaymentHistory[]
  priceHistory   PriceHistory[]

  @@index([userId])
  @@index([userId, status])
  @@index([nextPayment])
  @@index([userId, nextPayment])
}

model PaymentHistory {
  id             String       @id @default(cuid())
  subscriptionId String
  userId         String
  amount         Decimal      @db.Decimal(10, 2)
  currency       String
  paidAt         DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subscriptionId])
  @@index([userId, paidAt])
}

model PriceHistory {
  id             String       @id @default(cuid())
  subscriptionId String
  userId         String
  oldCost        Decimal      @db.Decimal(10, 2)
  newCost        Decimal      @db.Decimal(10, 2)
  currency       String
  changedAt      DateTime     @default(now())
  note           String?
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([userId])
}

model CategoryBudget {
  id         String   @id @default(cuid())
  userId     String
  category   String
  limit      Decimal  @db.Decimal(10, 2)
  currency   String   @default("INR")
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}

model SessionLog {
  id         String   @id @default(cuid())
  userId     String
  issuedAt   DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
