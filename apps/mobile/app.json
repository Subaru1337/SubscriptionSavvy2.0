{
  "expo": {
    "name": "Subsavvy",
    "slug": "mobile",
    "scheme": "subscriptionsavvy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.subscriptionsavvy.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/with-react-native-hermes-command",
      "expo-secure-store",
      "expo-router",
      "expo-video"
    ],
    "extra": {
      "router": {},
      "apiUrl": "https://subscription-savvy2-0-web.vercel.app/api",
      "eas": {
        "projectId": "31734d54-c717-4206-9030-cea9af5245f8"
      }
    }
  }
}
